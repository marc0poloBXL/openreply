// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  leads             Lead[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  /// IGAA token from Instagram Business Login (works with graph.instagram.com)
  accessToken       String
  /// EA/Page token from Facebook Login (works with graph.facebook.com for comments)
  pageToken         String?
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  dmFlowStates DmFlowState[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  // Lead-magnet conversation: when enabled, a matching DM starts a guided
  // flow (ask zodiac sign → ask email → deliver free report → upsell) instead
  // of sending the tracked-link button.
  dmLeadMagnetEnabled Boolean @default(false)
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  dmFlowStates     DmFlowState[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([commentId])
  @@index([automationId, commenterId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([automationId, status, createdAt])
  @@index([instagramAccountId, commenterId, status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

// One row per user per lead-magnet campaign: tracks where the user is in the
// guided DM conversation (which question was asked, what they answered, whether
// the free report was delivered). Drives the state machine in the DM worker.
model DmFlowState {
  id                 String   @id @default(cuid())
  automationId       String
  instagramAccountId String
  userId             String
  step               String   @default("ask_zodiac") // ask_zodiac | ask_email | awaiting_delivery | done
  zodiacSign         String?
  email              String?
  readingId          String?  // BirthdayReading id once the free report is generated
  attemptCount       Int      @default(0)
  lastMessageAt      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  birthdayReading  BirthdayReading? @relation(fields: [readingId], references: [id], onDelete: SetNull)

  @@unique([automationId, userId])
  @@index([instagramAccountId, step])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

/// A person who took the "What's Your Stoic Sign?" quiz and opted into follow-up.
model Lead {
  id          String   @id @default(cuid())
  workspaceId String?
  email       String   @unique
  zodiacSign  String?
  stoicMatch  String?
  stoicTitle  String?
  element     String?  /// fire / earth / air / water
  phone       String?
  source      String   @default("quiz") /// quiz | instagram | referral | birthday_reading
  leadScore   Int      @default(0)
  status      String   @default("new")  /// new | nurturing | warm | customer | churned
  lastContactedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consentEmail     Boolean   @default(false)
  consentSms       Boolean   @default(false)
  consentEmailAt   DateTime?
  consentSmsAt     DateTime?
  birthDate        DateTime? @db.Date
  birthTime        String?   /// "14:30" or null
  birthplace       String?

  workspace         Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  events            LeadEvent[]
  birthdayReadings  BirthdayReading[]
  payments          Payment[]
  scheduledFollowups ScheduledFollowup[]

  @@index([workspaceId])
  @@index([status])
  @@index([zodiacSign])
  @@index([consentEmail])
  @@index([consentSms])
}

/// Every interaction a lead has with the system (quiz completed, email opened,
/// link clicked, product purchased).
model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String   /// quiz_completed | email_sent | email_opened | link_clicked | purchased | birthday_reading_requested | birthday_reading_sent | consent_email | consent_sms | followup_sent
  metadata  Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([leadId, createdAt])
}

/// A birthday reading requested by a lead.
model BirthdayReading {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Nullable: DM lead-magnet readings are keyed by zodiac sign only (no birth
  // date is collected in that flow). Web-form readings always set it.
  birthDate       DateTime? @db.Date
  birthTime       String?  /// "14:30" or null
  birthplace      String?
  readingType     String   @default("stoic-life-blueprint") /// which prompt template
  readingText     String?  /// the generated reading
  pdfUrl          String?  /// link to downloadable PDF
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  flowStates DmFlowState[]

  @@index([leadId])
  @@index([createdAt])
}

/// A paid order for the full Stoic Birth Chart (birth date + time + place).
/// One payment refers to the lead it came from; nothing here stores card data.
model Payment {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// "stripe" | "paypal"
  provider   String
  /// provider's checkout/payment id
  providerId String?
  amountCents Int      @default(2700)
  currency   String   @default("usd")
  status     String   @default("pending") /// pending | paid
  /// the paid full-chart reading, generated after payment
  readingId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leadId])
  @@index([status])
}

/// A defined campaign (funnel) that triggers on a specific event.
model FollowupCampaign {
  id            String   @id @default(cuid())
  name          String
  triggerEvent  String   /// e.g. "birthday_reading_requested"
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps FollowupStep[]

  @@index([triggerEvent])
  @@index([isActive])
}

/// One step in a followup campaign — email, SMS, or wait.
model FollowupStep {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        FollowupCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepNumber      Int
  type            String   /// "EMAIL" | "SMS" | "WAIT"
  waitDays        Int      @default(0)
  emailSubject    String?
  emailBody       String?  /// HTML template
  smsBody         String?
  conditionType   String?  /// null (always) | "purchased" | "not_purchased" | "clicked" | "not_opened"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  scheduledFollowups ScheduledFollowup[]

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

/// A followup step scheduled for a specific lead.
model ScheduledFollowup {
  id              String     @id @default(cuid())
  leadId          String
  lead            Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followupStepId  String
  followupStep    FollowupStep @relation(fields: [followupStepId], references: [id], onDelete: Cascade)
  status          String     @default("PENDING") /// PENDING | SENT | SKIPPED | FAILED
  scheduledAt     DateTime
  sentAt          DateTime?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([leadId, followupStepId])
  @@index([leadId, status])
  @@index([status, scheduledAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
